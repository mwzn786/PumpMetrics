# Copy to .env on the server and fill in real values.

# Hostinger MySQL. Use localhost when MySQL runs on the same VPS,
# or the hostname from hPanel -> Databases when it is remote.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_generated_secret

# Must be the exact public URL, including https
NEXTAUTH_URL=https://yourdomain.com

# Only needed for the one-off seed that creates the first super admin
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=change_this_now
SEED_ADMIN_NAME=Super Admin
