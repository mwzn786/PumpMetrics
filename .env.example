# Copy to .env for local development.
# Use .env rather than .env.local: Next.js reads both, but the Prisma CLI
# only reads .env, so a single file keeps the two in sync.

# MySQL connection string
DATABASE_URL="mysql://root:password@localhost:3306/pumpmetrics"

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Optional: first super admin created by npm run db:seed
SEED_ADMIN_EMAIL=admin@pumpmetrics.com
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Super Admin
